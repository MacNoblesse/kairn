# Copier en « .env » (jamais commité). Tout est facultatif.

# Clé Gemini pour le Coach IA, les briefings et la vérification par IA.
# Sans clé, l'appli fonctionne mais ces fonctions répondent « non configuré ».
GEMINI_API_KEY=

# Port publié sur la machine hôte.
PORT=3000

# Adresse d'écoute sur l'hôte. 127.0.0.1 = ce PC seulement (recommandé : pas de mot de passe).
# 0.0.0.0 = tout le réseau local (téléphone à la maison). Pour l'accès distant : Tailscale (voir README).
BIND_ADDRESS=127.0.0.1

# Fuseau horaire (jour d'activité, sauvegardes quotidiennes).
TZ=Europe/Paris

# Origines autorisées à appeler l'API (CORS) : la WebView de l'APK Android. Séparées par des virgules.
# CORS_ORIGINS=https://localhost,capacitor://localhost,http://localhost
